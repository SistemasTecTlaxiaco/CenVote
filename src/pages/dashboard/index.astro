---
import Layout from '../../layouts/Layout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
---

<AuthGuard allowedRoles={['user']} />

<Layout title="Panel de Votación - CenVote">
  <div class="min-h-screen bg-gradient-to-br from-slate-950 via-purple-950/20 to-slate-950 py-6 sm:py-12 px-3 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-12">
      <!-- Sección de Bienvenida -->
      <div class="card-glass backdrop-blur-lg p-5 sm:p-8 rounded-2xl sm:rounded-3xl border-2 border-white/10 bg-gradient-to-r from-purple-900/30 to-blue-900/20 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-6">
        <div>
          <h1 class="text-4xl font-black bg-gradient-to-r from-white via-gray-100 to-purple-200 bg-clip-text text-transparent mb-2">
            ¡Hola, <span id="welcome-name">Elector</span>! 👋
          </h1>
          <p class="text-gray-300 max-w-xl">
            Aquí puedes ver las consultas ciudadanas activas en la red Stellar Testnet y ejercer tu voto de manera segura y transparente.
          </p>
        </div>
        <div class="flex-shrink-0 flex items-center gap-3">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center">
            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Tu Rol</p>
            <p class="text-lg font-bold text-purple-300">🗳️ Elector Autorizado</p>
          </div>
        </div>
      </div>

      <!-- Fila de Estado del Passkey y Wallet -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Tarjeta de Passkeys -->
        <div class="card-glass backdrop-blur-lg p-6 rounded-3xl border border-white/10 bg-white/5 flex flex-col justify-between" id="passkey-widget">
          <div>
            <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
              📱 Acceso Biométrico (Passkeys)
            </h3>
            <p class="text-sm text-gray-300 mb-6" id="passkey-widget-desc">
              Cargando información de seguridad...
            </p>
          </div>
          
          <!-- Formulario de vinculación si no tiene passkey -->
          <div id="passkey-setup-form" class="hidden space-y-4">
            <div class="flex flex-col sm:flex-row gap-2">
              <input type="text" id="passkey-device-name" placeholder="Nombre del dispositivo" class="input-modern py-2 text-sm flex-1">
              <button id="register-passkey-btn" class="bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white px-4 py-2.5 rounded-xl text-sm font-bold shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2 whitespace-nowrap">
                ⚡ Vincular
              </button>
            </div>
            <p class="text-[10px] text-gray-400">Protege tu cuenta con Windows Hello, Face ID o la huella digital de tu celular.</p>
          </div>

          <!-- Mensaje si ya tiene passkeys -->
          <div id="passkey-active-msg" class="hidden flex items-center gap-3 bg-green-500/10 border border-green-500/20 rounded-2xl p-4">
            <span class="text-2xl">🛡️</span>
            <div>
              <p class="text-xs text-green-300 font-bold">¡Tu cuenta está protegida!</p>
              <p class="text-xs text-gray-400" id="passkey-count-text">Tienes passkeys activas registradas.</p>
            </div>
          </div>
        </div>

        <!-- Tarjeta de Wallet Stellar -->
        <div class="card-glass backdrop-blur-lg p-6 rounded-3xl border border-white/10 bg-white/5 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
              🚀 Wallet Stellar Freighter
            </h3>
            <p class="text-sm text-gray-300 mb-4">
              Para votar en las encuestas ciudadanas, es necesario conectar tu Freighter Wallet. Los votos se firman y se registran en Stellar Testnet.
            </p>
          </div>
          <div class="space-y-4">
            <div class="flex items-center gap-3 bg-purple-500/10 border border-purple-500/20 rounded-2xl p-4">
              <span class="text-2xl">🔑</span>
              <div class="flex-1 min-w-0">
                <p class="text-xs text-purple-300 font-bold">Dirección de Wallet</p>
                <p class="text-xs text-gray-400 font-mono truncate" id="wallet-address-display">No conectada</p>
              </div>
            </div>
            
            <button id="dashboard-connect-wallet-btn" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold text-sm shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2">
              🔗 Conectar Wallet
            </button>
          </div>
        </div>
      </div>

      <!-- Listado de Encuestas -->
      <div>
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
          <span class="text-3xl">🗳️</span> Consultas Ciudadanas Disponibles
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="surveysList">
          <div class="col-span-full text-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-500 mx-auto mb-4"></div>
            <p class="text-gray-400">Cargando encuestas disponibles...</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Votación -->
  <div id="voteModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="card-glass w-full sm:max-w-2xl p-5 sm:p-8 rounded-t-3xl sm:rounded-3xl border-2 border-white/20 max-h-[92vh] sm:max-h-[90vh] overflow-y-auto bg-slate-900">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h2 class="text-3xl font-bold text-white mb-2" id="modalSurveyName"></h2>
          <p class="text-gray-300" id="modalSurveyDescription"></p>
        </div>
        <button id="close-modal-btn" class="text-white hover:text-red-400 text-2xl transition-colors">✕</button>
      </div>
      
      <div id="voteContent">
        <!-- Cargado dinámicamente -->
      </div>
    </div>
  </div>
</Layout>

<script>
  import { authService } from '../../services/AuthService';
  import { freighterService } from '../../services/FreighterService';
  import { registerPasskey } from '../../services/PasskeyService';
  
  const API_URL = (typeof import.meta !== 'undefined' && typeof import.meta.env !== 'undefined' && import.meta.env.PUBLIC_API_URL) || (typeof window !== 'undefined' ? (window.location.protocol === 'https:' ? 'https://' + window.location.hostname + ':3001' : 'http://' + window.location.hostname + ':3000') : 'http://localhost:3000');

  let userPublicKey = null;
  let currentSurveyId = null;

  // Cargar perfil del elector
  function setupProfile() {
    const user = authService.getUser();
    if (user) {
      const nameEl = document.getElementById('welcome-name');
      if (nameEl) nameEl.textContent = user.first_name || user.email || 'Elector';
      
      checkPasskeys(user.email || user.username);
    }
  }

  // Verificar passkeys registradas en el backend
  async function checkPasskeys(username: string) {
    try {
      const response = await fetch(`${API_URL}/api/passkey/list/${username}`);
      const descEl = document.getElementById('passkey-widget-desc');
      const setupForm = document.getElementById('passkey-setup-form');
      const activeMsg = document.getElementById('passkey-active-msg');
      const countText = document.getElementById('passkey-count-text');

      if (response.ok) {
        const credentials = await response.json();
        if (credentials.length > 0) {
          if (descEl) descEl.textContent = 'Tu cuenta ya está asegurada con un passkey. Puedes seguir agregando más dispositivos si lo deseas.';
          if (setupForm) setupForm.classList.remove('hidden');
          if (activeMsg) activeMsg.classList.remove('hidden');
          if (countText) countText.textContent = `Tienes ${credentials.length} passkey(s) vinculada(s) a tu cuenta.`;
        } else {
          if (descEl) descEl.textContent = 'Aún no has activado las Passkeys. Actívalas ahora para iniciar sesión con tu huella digital o rostro sin contraseñas.';
          if (setupForm) setupForm.classList.remove('hidden');
          if (activeMsg) activeMsg.classList.add('hidden');
        }
      }
    } catch (err) {
      console.error('Error al consultar passkeys:', err);
    }
  }

  // Registrar nueva Passkey
  const registerPasskeyBtn = document.getElementById('register-passkey-btn');
  registerPasskeyBtn?.addEventListener('click', async () => {
    const deviceInput = document.getElementById('passkey-device-name') as HTMLInputElement;
    const deviceName = deviceInput.value.trim() || 'Mi Dispositivo';
    const user = authService.getUser();
    if (!user) return;

    registerPasskeyBtn.setAttribute('disabled', 'true');
    const originalText = registerPasskeyBtn.textContent;
    registerPasskeyBtn.textContent = 'Procesando...';

    try {
      await registerPasskey({
        name: user.email || user.username,
        displayName: user.first_name || user.email,
        deviceName: deviceName
      });
      alert('✓ Passkey vinculada exitosamente a este dispositivo');
      deviceInput.value = '';
      checkPasskeys(user.email || user.username);
    } catch (err: any) {
      alert('❌ Error al registrar passkey: ' + err.message);
    } finally {
      registerPasskeyBtn.removeAttribute('disabled');
      registerPasskeyBtn.textContent = originalText;
    }
  });

  // Detectar y actualizar el estado de Freighter
  async function checkWallet() {
    const display = document.getElementById('wallet-address-display');
    const connectBtn = document.getElementById('dashboard-connect-wallet-btn');
    const isConnected = await freighterService.checkConnection();
    
    if (isConnected && freighterService.publicKey) {
      userPublicKey = freighterService.publicKey;
      if (display) display.textContent = userPublicKey;
      if (connectBtn) {
        connectBtn.textContent = '✅ Wallet Conectada';
        connectBtn.className = 'w-full py-2.5 px-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 font-bold text-sm transition-all cursor-default flex items-center justify-center gap-2';
        (connectBtn as HTMLButtonElement).disabled = true;
      }
    } else {
      userPublicKey = null;
      if (display) display.textContent = 'No conectada';
      if (connectBtn) {
        connectBtn.textContent = '🔗 Conectar Wallet';
        connectBtn.className = 'w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold text-sm shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2';
        (connectBtn as HTMLButtonElement).disabled = false;
      }
    }
  }

  // Evento conectar wallet desde dashboard
  const dashboardConnectBtn = document.getElementById('dashboard-connect-wallet-btn');
  dashboardConnectBtn?.addEventListener('click', async () => {
    try {
      const isInstalled = await freighterService.isFreighterInstalled();
      if (!isInstalled) {
        const shouldInstall = confirm('Freighter no está instalado. ¿Deseas ir a la página de instalación?');
        if (shouldInstall) window.open('https://www.freighter.app', '_blank');
        return;
      }
      dashboardConnectBtn.setAttribute('disabled', 'true');
      dashboardConnectBtn.textContent = 'Conectando...';
      const result = await freighterService.connect();
      if (result.success) {
        checkWallet();
      } else {
        alert('Error al conectar: ' + result.message);
      }
    } catch (err: any) {
      alert('Error inesperado: ' + err.message);
    } finally {
      dashboardConnectBtn?.removeAttribute('disabled');
    }
  });

  // Escuchar eventos de Freighter
  window.addEventListener('walletConnected', (event: any) => {
    userPublicKey = event.detail.publicKey;
    const display = document.getElementById('wallet-address-display');
    if (display) display.textContent = userPublicKey;
    
    const connectBtn = document.getElementById('dashboard-connect-wallet-btn');
    if (connectBtn) {
      connectBtn.textContent = '✅ Wallet Conectada';
      connectBtn.className = 'w-full py-2.5 px-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 font-bold text-sm transition-all cursor-default flex items-center justify-center gap-2';
      (connectBtn as HTMLButtonElement).disabled = true;
    }

    if (currentSurveyId) {
      openVoteModal(currentSurveyId);
    }
  });

  window.addEventListener('walletDisconnected', () => {
    userPublicKey = null;
    const display = document.getElementById('wallet-address-display');
    if (display) display.textContent = 'No conectada';
    
    const connectBtn = document.getElementById('dashboard-connect-wallet-btn');
    if (connectBtn) {
      connectBtn.textContent = '🔗 Conectar Wallet';
      connectBtn.className = 'w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold text-sm shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2';
      (connectBtn as HTMLButtonElement).disabled = false;
    }
  });

  // Cargar encuestas activas
  async function loadSurveys() {
    try {
      const response = await fetch(`${API_URL}/api/surveys`);
      const surveys = await response.json();
      const surveysList = document.getElementById('surveysList');
      
      if (!surveysList) return;

      if (surveys.length === 0) {
        surveysList.innerHTML = `
          <div class="col-span-full text-center text-gray-400 py-12">
            No hay encuestas creadas en este momento
          </div>
        `;
        return;
      }
      
      // Filtrar y mostrar encuestas
      surveysList.innerHTML = surveys.map(survey => {
        const startDate = new Date(survey.start_date);
        const endDate = new Date(survey.end_date);
        const now = new Date();
        const isActive = now >= startDate && now <= endDate;
        
        return `
          <div class="card-gradient p-6 rounded-2xl border border-white/10 bg-white/5 hover:border-white/20 transition-all flex flex-col justify-between h-full">
            <div>
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-xl font-bold text-white line-clamp-1">${survey.name}</h3>
                <span class="px-3 py-1 rounded-full text-xs font-semibold ${isActive ? 'bg-green-500/20 text-green-300' : 'bg-gray-500/20 text-gray-300'}">
                  ${isActive ? '🟢 Activa' : '⚫ Inactiva'}
                </span>
              </div>
              <p class="text-gray-300 text-sm mb-4 line-clamp-3">${survey.description}</p>
              <div class="space-y-2 mb-6 text-xs text-gray-400">
                <p>📅 Inicio: ${startDate.toLocaleString()}</p>
                <p>📅 Fin: ${endDate.toLocaleString()}</p>
              </div>
            </div>
            <button onclick="window.openVoteModal('${survey._id}')"
              class="w-full btn-primary text-sm py-2.5 ${!isActive ? 'opacity-50 cursor-not-allowed' : ''}"
              ${!isActive ? 'disabled' : ''}>
              🗳️ Votar o Ver Resultados
            </button>
          </div>
        `;
      }).join('');
    } catch (error) {
      console.error('Error al cargar encuestas:', error);
      const surveysList = document.getElementById('surveysList');
      if (surveysList) {
        surveysList.innerHTML = `
          <div class="col-span-full text-center text-red-400 py-12">
            Error al conectar con el servidor de encuestas.
          </div>
        `;
      }
    }
  }

  // Abrir modal de votación
  async function openVoteModal(surveyId) {
    currentSurveyId = surveyId;
    
    // Verificar que el usuario tenga wallet conectada
    if (!userPublicKey) {
      const shouldConnect = confirm('Necesitas conectar tu Freighter Wallet para votar. ¿Deseas conectarla ahora?');
      if (shouldConnect) {
        const connectBtn = document.getElementById('connectWalletBtn');
        if (connectBtn) {
          connectBtn.click();
        }
        return;
      } else {
        currentSurveyId = null;
        return;
      }
    }
    
    try {
      // Cargar información de la encuesta
      const surveyResponse = await fetch(`${API_URL}/api/surveys/${surveyId}`);
      const survey = await surveyResponse.json();
      
      // Verificar si ya votó
      const voteCheckResponse = await fetch(`${API_URL}/api/surveys/${surveyId}/check-vote`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ voterAddress: userPublicKey })
      });
      const { hasVoted } = await voteCheckResponse.json();
      
      // Cargar resultados
      const resultsResponse = await fetch(`${API_URL}/api/surveys/${surveyId}/results`);
      const results = await resultsResponse.json();
      
      // Mostrar en modal
      const nameModal = document.getElementById('modalSurveyName');
      const descModal = document.getElementById('modalSurveyDescription');
      if (nameModal) nameModal.textContent = survey.name;
      if (descModal) descModal.textContent = survey.description;
      
      const voteContent = document.getElementById('voteContent');
      if (!voteContent) return;
      
      if (hasVoted) {
        // Mostrar resultados
        voteContent.innerHTML = `
          <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-4 mb-6 text-center text-green-300 font-semibold flex items-center justify-center gap-2">
            <span>✓ Ya has votado en esta encuesta</span>
          </div>
          ${renderResults(results)}
        `;
      } else {
        // Mostrar opciones de voto
        voteContent.innerHTML = `
          <div class="mb-6">
            <h3 class="text-sm font-bold text-purple-300 uppercase tracking-wider mb-4">Selecciona tu opción de voto:</h3>
            <div class="space-y-3">
              ${results.results.map(result => `
                <button onclick="window.vote('${result.candidateId}')"
                  class="w-full text-left p-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-purple-400 transition-all flex items-center justify-between group">
                  <span class="text-white font-semibold group-hover:text-purple-300">${result.candidateName}</span>
                  <span class="text-xl group-hover:scale-110 transition-transform">👍</span>
                </button>
              `).join('')}
            </div>
          </div>
          <div class="border-t border-white/10 pt-6">
            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Resultados parciales actuales:</h4>
            ${renderResults(results)}
          </div>
        `;
      }
      
      document.getElementById('voteModal')?.classList.remove('hidden');
    } catch (error) {
      console.error('Error al abrir modal:', error);
      alert('Error al cargar la información de la encuesta');
    }
  }

  // Renderizar resultados en el modal
  function renderResults(results) {
    if (results.totalVotes === 0) {
      return '<p class="text-gray-400 text-sm py-4 text-center">Aún no se han registrado votos en esta consulta ciudadana</p>';
    }
    
    const sortedResults = [...results.results].sort((a, b) => b.percentage - a.percentage);
    const winnerPercentage = sortedResults[0].percentage;
    
    return `
      <div class="space-y-4">
        <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Total Votos: <span class="text-white font-black text-sm">${results.totalVotes}</span></p>
        ${sortedResults.map((result, index) => {
          const isWinning = result.percentage === winnerPercentage && result.percentage > 0;
          const position = index + 1;
          
          let barColor = 'from-gray-500 to-gray-600';
          let borderColor = 'border-gray-500/20';
          let badgeColor = 'bg-gray-500/20 text-gray-300';
          let emoji = '';
          
          if (isWinning) {
            barColor = 'from-purple-500 via-purple-600 to-blue-500';
            borderColor = 'border-purple-500/30';
            badgeColor = 'bg-purple-500/25 text-purple-300 border border-purple-400/20';
            emoji = '🏆 ';
          }
          
          return `
            <div class="relative p-4 rounded-2xl bg-white/5 border ${borderColor} ${isWinning ? 'ring-2 ring-purple-500/20 shadow-lg' : ''}">
              <div class="flex justify-between items-center mb-2">
                <div class="flex items-center gap-2">
                  <span class="text-white font-bold text-sm">${emoji}${result.candidateName}</span>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold ${badgeColor}">#${position}</span>
                </div>
                <div class="text-right">
                  <div class="text-white font-black text-sm">${result.percentage.toFixed(1)}%</div>
                  <div class="text-[10px] text-gray-400">${result.votes} voto${result.votes !== 1 ? 's' : ''}</div>
                </div>
              </div>
              <div class="w-full bg-black/45 rounded-full h-3 overflow-hidden">
                <div class="bg-gradient-to-r ${barColor} h-full rounded-full" style="width: ${result.percentage}%"></div>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  // Realizar voto con Freighter (Stellar Transaction)
  async function vote(candidateId) {
    try {
      const { votingService } = await import('../../services/VotingService');
      const voteFee = votingService.getVoteFee();
      
      const confirmMessage = `¿Confirmas tu voto por esta opción?\n\n💰 Tarifa: ${voteFee} XLM\n\nEl costo se deducirá de tu billetera Stellar en Testnet.`;
      
      if (!confirm(confirmMessage)) return;
      
      const voteContent = document.getElementById('voteContent');
      if (!voteContent) return;
      const originalContent = voteContent.innerHTML;
      
      voteContent.innerHTML = `
        <div class="text-center py-12 space-y-4">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-purple-500 mx-auto"></div>
          <p class="text-white font-semibold">Firmando y procesando voto en la red Stellar...</p>
          <p class="text-xs text-gray-400">Por favor, firma la transacción cuando aparezca Freighter Wallet.</p>
        </div>
      `;
      
      const result = await votingService.vote({
        surveyId: currentSurveyId,
        candidateId: candidateId,
        voterAddress: userPublicKey
      });
      
      if (result.success) {
        alert('✓ ¡Tu voto ha sido registrado correctamente!');
        openVoteModal(currentSurveyId);
      } else {
        voteContent.innerHTML = originalContent;
        alert('❌ Error al votar: ' + result.message);
      }
    } catch (error: any) {
      console.error('Error en votación:', error);
      const voteContent = document.getElementById('voteContent');
      if (voteContent && typeof originalContent !== 'undefined') {
        voteContent.innerHTML = originalContent;
      }
      alert('Error inesperado al emitir el voto: ' + error.message);
    }
  }

  // Cerrar modal
  function closeModal() {
    document.getElementById('voteModal')?.classList.add('hidden');
    currentSurveyId = null;
  }

  // Inicialización
  function initDashboard() {
    setupProfile();
    checkWallet();
    loadSurveys();
    
    document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }

  // Exportar al objeto global window para invocaciones inline onclick
  (window as any).openVoteModal = openVoteModal;
  (window as any).vote = vote;
  (window as any).closeVoteModal = closeModal;
</script>
