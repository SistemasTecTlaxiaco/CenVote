---
import Layout from '../../layouts/Layout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
---

<AuthGuard allowedRoles={['admin']} />

<Layout title="Gestión de Encuestas - CenVote">
  <div class="min-h-screen bg-gradient-to-br from-slate-950 via-purple-900 to-slate-950 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="card-glass backdrop-blur-lg p-8 rounded-3xl border-2 border-white/20">
        <h1 class="text-4xl font-black header-gradient mb-8">📊 Gestión de Encuestas</h1>
        
        <!-- Formulario de Encuesta -->
        <form id="surveyForm" class="space-y-6 mb-12" novalidate>
          <input type="hidden" id="surveyId" name="surveyId">
          
          <!-- Alert Section -->
          <div id="formAlert" class="hidden p-4 rounded-lg border-2 transition-all duration-300"
            role="alert"></div>
          
          <div class="grid grid-cols-1 gap-6">
            <div>
              <label for="name" class="block text-sm font-semibold text-white mb-2">
                Nombre de la Encuesta <span class="text-red-400">*</span>
              </label>
              <input type="text" id="name" name="name" required
                placeholder="Ej: Votación Municipal 2026"
                class="input-modern focus:ring-2 focus:ring-purple-500 transition-all peer"
                minlength="3" maxlength="100">
              <p class="text-xs text-red-400 mt-1 hidden peer-invalid:block">
                El nombre debe tener entre 3 y 100 caracteres
              </p>
            </div>
            
            <div>
              <label for="description" class="block text-sm font-semibold text-white mb-2">
                Descripción <span class="text-red-400">*</span>
              </label>
              <textarea id="description" name="description" rows="4" required
                placeholder="Describe el propósito y contexto de esta encuesta..."
                class="input-modern resize-none focus:ring-2 focus:ring-purple-500 transition-all peer"
                minlength="10" maxlength="500"></textarea>
              <p class="text-xs text-gray-400 mt-1">
                <span id="descriptionCount">0</span>/500 caracteres
              </p>
              <p class="text-xs text-red-400 mt-1 hidden peer-invalid:block">
                La descripción debe tener entre 10 y 500 caracteres
              </p>
            </div>
            
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="start_date" class="block text-sm font-semibold text-white mb-2">
                  Fecha de Inicio <span class="text-red-400">*</span>
                </label>
                <input type="datetime-local" id="start_date" name="start_date" required
                  class="input-modern focus:ring-2 focus:ring-purple-500 transition-all peer">
                <p class="text-xs text-red-400 mt-1 hidden peer-invalid:block">
                  Selecciona una fecha de inicio válida
                </p>
              </div>
              
              <div>
                <label for="end_date" class="block text-sm font-semibold text-white mb-2">
                  Fecha de Fin <span class="text-red-400">*</span>
                </label>
                <input type="datetime-local" id="end_date" name="end_date" required
                  class="input-modern focus:ring-2 focus:ring-purple-500 transition-all peer">
                <p class="text-xs text-red-400 mt-1 hidden" id="endDateError">
                  La fecha de fin debe ser posterior a la fecha de inicio
                </p>
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-white mb-3">
                Candidatos (haz clic para seleccionar) <span class="text-red-400">*</span>
              </label>
              <div id="candidatesGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 bg-white/5 rounded-xl border-2 border-white/10 max-h-96 overflow-y-auto transition-colors"
                data-selected="0">
                <!-- Los candidatos se cargarán aquí -->
              </div>
              <p class="text-xs text-gray-400 mt-2">
                Candidatos seleccionados: <span id="candidateCount" class="font-semibold text-purple-400">0</span>
              </p>
              <p class="text-xs text-red-400 mt-1 hidden" id="candidatesError">
                Debes seleccionar al menos un candidato
              </p>
              <input type="hidden" id="selectedCandidates" name="selectedCandidates">
            </div>
          </div>
          
          <div class="flex justify-end space-x-4 pt-4 border-t border-white/10">
            <button type="button" id="cancelBtn" style="display: none;"
              class="px-6 py-2 rounded-lg font-semibold transition-all duration-300 bg-gradient-to-r from-gray-600 to-gray-700 text-white hover:from-gray-700 hover:to-gray-800">
              ❌ Cancelar
            </button>
            <button type="submit" id="submitBtn"
              class="btn-accent transition-all duration-300"
              disabled>
              <span id="submitBtnText">✨ Crear Encuesta</span>
            </button>
          </div>
        </form>

        <!-- Lista de Encuestas -->
        <div class="mt-12">
          <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
            <span class="text-3xl">🗳️</span> Encuestas Activas
          </h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="surveysList">
            <!-- Las encuestas se cargarán aquí -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Votación -->
  <div id="voteModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="card-glass max-w-2xl w-full p-8 rounded-3xl border-2 border-white/20 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h2 class="text-3xl font-bold text-white mb-2" id="modalSurveyName"></h2>
          <p class="text-gray-300" id="modalSurveyDescription"></p>
        </div>
        <button onclick="closeVoteModal()" class="text-white hover:text-red-400 text-2xl">✕</button>
      </div>
      
      <div id="voteContent">
        <!-- Se cargará dinámicamente -->
      </div>
    </div>
  </div>

  <!-- Modal de Transacción (Creación de Encuesta) -->
  <div id="txModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-[60] flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="card-glass max-w-md w-full p-8 rounded-3xl border-2 border-purple-500/30 text-center shadow-2xl shadow-purple-500/20">
      <div id="txSpinner" class="mb-6">
        <div class="w-16 h-16 border-4 border-purple-500/30 border-t-purple-500 rounded-full animate-spin mx-auto"></div>
      </div>
      <div id="txSuccess" class="hidden mb-6 text-6xl animate-bounce">
        ✅
      </div>
      <div id="txError" class="hidden mb-6 text-6xl">
        ❌
      </div>
      
      <h2 id="txTitle" class="text-2xl font-bold text-white mb-3">Procesando Transacción</h2>
      <p id="txMessage" class="text-gray-300 mb-6">Iniciando cobro de 5 XLM...</p>
      
      <div id="txDetails" class="bg-black/40 p-4 rounded-xl border border-white/10 text-xs text-left hidden mb-6 text-gray-400 break-all font-mono">
      </div>

      <button id="txCloseBtn" type="button" class="hidden w-full btn-primary py-3" onclick="closeTxModal()">
        Cerrar
      </button>
    </div>
  </div>
</Layout>

<script>
  let publicKey = null;
  let isEditing = false;
  let editingId = null;
  let currentSurveyId = null;

  // Conexión con Freighter
  import { freighterService } from '../../services/FreighterService';
  
  const API_URL = (typeof import.meta !== 'undefined' && typeof import.meta.env !== 'undefined' && import.meta.env.PUBLIC_API_URL) || (typeof window !== 'undefined' ? (window.location.protocol === 'https:' ? 'https://' + window.location.hostname + ':3001' : 'http://' + window.location.hostname + ':3000') : 'http://localhost:3000');

  // Auto-detectar wallet conectada
  async function autoDetectWallet() {
    // Siempre verificar el estado real de la conexión con la extensión
    const isConnected = await freighterService.checkConnection();
    
    if (isConnected && freighterService.publicKey) {
      publicKey = freighterService.publicKey;
      updateWalletButton(true);
      console.log('✅ Wallet auto-detectada y verificada:', publicKey.slice(0, 8) + '...');
    } else if (freighterService.publicKey) {
      // Tenemos datos guardados pero no conexión activa con la extensión
      // Intentamos reconectar explícitamente
      const result = await freighterService.connect();
      if (result.success) {
        publicKey = result.publicKey;
        updateWalletButton(true);
        console.log('✅ Wallet reconectada automáticamente');
      } else {
        // Si falla, limpiamos el estado visual
        updateWalletButton(false);
      }
    }
  }

  // Actualizar botón de wallet
  function updateWalletButton(connected) {
    const btn = document.getElementById('connectWalletBtn');
    if (connected && publicKey) {
      btn.textContent = `✅ ${publicKey.slice(0, 6)}...${publicKey.slice(-4)}`;
      btn.classList.remove('btn-primary');
      btn.classList.add('bg-green-600', 'hover:bg-green-700');
    } else {
      btn.textContent = '🔗 Conectar Wallet';
      btn.classList.remove('bg-green-600', 'hover:bg-green-700');
      btn.classList.add('btn-primary');
    }
  }

  // Escuchar eventos de wallet
  window.addEventListener('walletConnected', (event: any) => {
    publicKey = event.detail.publicKey;
    updateWalletButton(true);
    console.log('📡 Evento de wallet conectada recibido');
  });

  window.addEventListener('walletDisconnected', () => {
    publicKey = null;
    updateWalletButton(false);
    console.log('📡 Evento de wallet desconectada recibido');
  });

  async function connectWallet() {
    try {
      const result = await freighterService.connect();
      
      if (result.success) {
        publicKey = result.publicKey;
        updateWalletButton(true);
        
        if (publicKey === freighterService.expectedPublicKey) {
            console.log('✅ Cuenta verificada en formulario de encuestas');
        }
      } else {
        alert(result.message);
      }

    } catch (error) {
      console.error("Error al conectar wallet:", error);
      alert("Error al conectar con Freighter");
    }
  }

  // Cargar candidatos para el selector
  let selectedCandidateIds = [];
  
  async function loadCandidateOptions() {
    try {
      const response = await fetch(`${API_URL}/api/candidates`);
      const candidates = await response.json();
      const gridElement = document.getElementById('candidatesGrid');
      
      gridElement.innerHTML = candidates.map(candidate => `
        <label class="candidate-card cursor-pointer group" data-candidate-id="${candidate._id}">
          <input type="checkbox" class="hidden candidate-checkbox" value="${candidate._id}">
          <div class="p-4 rounded-xl bg-white/5 border-2 border-white/20 hover:border-purple-500/50 transition-all duration-300 group-hover:bg-white/10">
            <div class="flex items-start gap-3">
              <div class="mt-1 flex-shrink-0">
                <div class="checkbox-custom w-5 h-5 rounded border-2 border-white/40 flex items-center justify-center transition-all">
                  <svg class="checkmark hidden w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="text-white font-semibold truncate">${candidate.name}</h4>
                <p class="text-gray-400 text-sm truncate">${candidate.rfc || 'Sin email'}</p>
              </div>
            </div>
          </div>
        </label>
      `).join('');
      
      // Función para actualizar contador y validación de candidatos
      function updateCandidateCount() {
        const count = selectedCandidateIds.length;
        document.getElementById('candidateCount').textContent = count;
        document.getElementById('selectedCandidates').value = selectedCandidateIds.join(',');
        
        // Validar y actualizar estado visual
        const gridElement = document.getElementById('candidatesGrid');
        if (count > 0) {
          gridElement.classList.add('border-purple-500', 'border-purple-500/30');
          gridElement.classList.remove('border-white/10');
          document.getElementById('candidatesError').classList.add('hidden');
        } else {
          gridElement.classList.remove('border-purple-500', 'border-purple-500/30');
          gridElement.classList.add('border-white/10');
        }
        validateForm();
      }
      
      // Event delegation para checkboxes
      gridElement.addEventListener('click', (e) => {
        const card = e.target.closest('.candidate-card');
        if (card) {
          const checkbox = card.querySelector('.candidate-checkbox');
          const checkboxCustom = card.querySelector('.checkbox-custom');
          const checkmark = card.querySelector('.checkmark');
          const cardDiv = card.querySelector('div');
          
          checkbox.checked = !checkbox.checked;
          
          if (checkbox.checked) {
            checkboxCustom.classList.add('bg-purple-600', 'border-purple-600');
            checkmark.classList.remove('hidden');
            cardDiv.classList.add('ring-2', 'ring-purple-500/50', 'bg-purple-500/10');
            if (!selectedCandidateIds.includes(checkbox.value)) {
              selectedCandidateIds.push(checkbox.value);
            }
          } else {
            checkboxCustom.classList.remove('bg-purple-600', 'border-purple-600');
            checkmark.classList.add('hidden');
            cardDiv.classList.remove('ring-2', 'ring-purple-500/50', 'bg-purple-500/10');
            selectedCandidateIds = selectedCandidateIds.filter(id => id !== checkbox.value);
          }
          
          updateCandidateCount();
        }
      });
    } catch (error) {
      console.error('Error al cargar candidatos:', error);
      document.getElementById('formAlert').classList.remove('hidden');
      document.getElementById('formAlert').innerHTML = `
        <div class="bg-red-500/20 border-red-500 text-red-300">
          <strong>⚠️ Error:</strong> No se pudieron cargar los candidatos. Por favor, recarga la página.
        </div>
      `;
    }
  }

  // Función de validación del formulario
  function validateForm() {
    const form = document.getElementById('surveyForm');
    const nameInput = document.getElementById('name');
    const descriptionInput = document.getElementById('description');
    const startDateInput = document.getElementById('start_date');
    const endDateInput = document.getElementById('end_date');
    const submitBtn = document.getElementById('submitBtn');
    
    // Validar nombre
    const nameValid = nameInput.value.length >= 3 && nameInput.value.length <= 100;
    
    // Validar descripción
    const descValid = descriptionInput.value.length >= 10 && descriptionInput.value.length <= 500;
    
    // Validar fechas
    const startDate = new Date(startDateInput.value);
    const endDate = new Date(endDateInput.value);
    const datesValid = startDateInput.value && endDateInput.value && startDate < endDate;
    
    // Validar candidatos
    const candidatesValid = selectedCandidateIds.length > 0;
    
    // Mostrar/ocultar error de fechas
    const endDateError = document.getElementById('endDateError');
    if (!datesValid && endDateInput.value) {
      endDateError.classList.remove('hidden');
    } else {
      endDateError.classList.add('hidden');
    }
    
    // Habilitar/deshabilitar botón de envío
    const isFormValid = nameValid && descValid && datesValid && candidatesValid;
    submitBtn.disabled = !isFormValid;
    
    if (isFormValid) {
      submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }
  }

  // Event listeners para validación en tiempo real
  document.getElementById('name').addEventListener('input', () => {
    validateForm();
  });
  
  document.getElementById('description').addEventListener('input', (e) => {
    document.getElementById('descriptionCount').textContent = e.target.value.length;
    validateForm();
  });
  
  document.getElementById('start_date').addEventListener('change', validateForm);
  document.getElementById('end_date').addEventListener('change', validateForm);

  // Cargar encuestas
  async function loadSurveys() {
    try {
      const response = await fetch(`${API_URL}/api/surveys`);
      const surveys = await response.json();
      const surveysList = document.getElementById('surveysList');
      
      if (surveys.length === 0) {
        surveysList.innerHTML = `
          <div class="col-span-full text-center text-gray-400 py-12">
            No hay encuestas creadas aún
          </div>
        `;
        return;
      }
      
      surveysList.innerHTML = surveys.map(survey => {
        const startDate = new Date(survey.start_date);
        const endDate = new Date(survey.end_date);
        const now = new Date();
        const isActive = now >= startDate && now <= endDate;
        
        return `
          <div class="card-gradient p-6 rounded-2xl border border-white/20 hover:border-white/40 transition-all">
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-xl font-bold text-white">${survey.name}</h3>
              <span class="px-3 py-1 rounded-full text-xs font-semibold ${isActive ? 'bg-green-500/20 text-green-300' : 'bg-gray-500/20 text-gray-300'}">
                ${isActive ? '🟢 Activa' : '⚫ Inactiva'}
              </span>
            </div>
            <p class="text-gray-300 text-sm mb-4 line-clamp-2">${survey.description}</p>
            <div class="space-y-2 mb-4">
              <p class="text-xs text-gray-400">
                📅 Inicio: ${startDate.toLocaleString('es-MX')}
              </p>
              <p class="text-xs text-gray-400">
                📅 Fin: ${endDate.toLocaleString('es-MX')}
              </p>
              <p class="text-xs text-purple-300">
                👥 ${survey.candidates ? survey.candidates.length : 0} candidatos
              </p>
            </div>
            <div class="flex gap-2 flex-wrap">
              <button onclick="openVoteModal('${survey._id}')"
                class="flex-1 btn-primary text-sm py-2 ${!isActive ? 'opacity-50 cursor-not-allowed' : ''}"
                ${!isActive ? 'disabled' : ''}>
                🗳️ Votar
              </button>
              <button onclick="editSurvey('${survey._id}')"
                class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-sm py-2 px-4 rounded-lg transition-all">
                ✏️ Editar
              </button>
              <button onclick="deleteSurvey('${survey._id}')"
                class="flex-1 bg-red-600 hover:bg-red-700 text-white text-sm py-2 px-4 rounded-lg transition-all">
                🗑️ Eliminar
              </button>
            </div>
          </div>
        `;
      }).join('');
    } catch (error) {
      console.error('Error al cargar encuestas:', error);
    }
  }

  // Abrir modal de votación
  async function openVoteModal(surveyId) {
    currentSurveyId = surveyId;
    
    // Verificar que el usuario tenga wallet conectada
    if (!publicKey) {
      const shouldConnect = confirm('Necesitas conectar tu wallet para votar. ¿Conectar ahora?');
      if (shouldConnect) {
        await connectWallet();
        if (!publicKey) return;
      } else {
        return;
      }
    }
    
    try {
      // Cargar información de la encuesta
      const surveyResponse = await fetch(`${API_URL}/api/surveys/${surveyId}`);
      const survey = await surveyResponse.json();
      
      // Verificar si ya votó
      const voteCheckResponse = await fetch(`${API_URL}/api/surveys/${surveyId}/check-vote`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ voterAddress: publicKey })
      });
      const { hasVoted } = await voteCheckResponse.json();
      
      // Cargar resultados
      const resultsResponse = await fetch(`${API_URL}/api/surveys/${surveyId}/results`);
      const results = await resultsResponse.json();
      
      // Mostrar en modal
      document.getElementById('modalSurveyName').textContent = survey.name;
      document.getElementById('modalSurveyDescription').textContent = survey.description;
      
      const voteContent = document.getElementById('voteContent');
      
      if (hasVoted) {
        // Mostrar solo resultados si ya votó
        voteContent.innerHTML = `
          <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-4 mb-6">
            <p class="text-yellow-300 font-semibold">✓ Ya has votado en esta encuesta</p>
          </div>
          ${renderResults(results)}
        `;
      } else {
        // Mostrar opciones de voto
        voteContent.innerHTML = `
          <div class="mb-6">
            <h3 class="text-lg font-semibold text-white mb-4">Selecciona tu candidato:</h3>
            <div class="space-y-3">
              ${results.results.map(result => `
                <button onclick="vote('${result.candidateId}')"
                  class="w-full text-left p-4 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 hover:border-blue-400 transition-all group">
                  <div class="flex items-center justify-between">
                    <span class="text-white font-semibold group-hover:text-blue-300">${result.candidateName}</span>
                    <span class="text-2xl group-hover:scale-110 transition-transform">👍</span>
                  </div>
                </button>
              `).join('')}
            </div>
          </div>
          <div class="border-t border-white/20 pt-6">
            <h4 class="text-sm font-semibold text-gray-400 mb-3">Resultados parciales:</h4>
            ${renderResults(results)}
          </div>
        `;
      }
      
      document.getElementById('voteModal').classList.remove('hidden');
    } catch (error) {
      console.error('Error al abrir modal:', error);
      alert('Error al cargar información de la encuesta');
    }
  }

  // Renderizar resultados
  function renderResults(results) {
    if (results.totalVotes === 0) {
      return '<p class="text-gray-400 text-sm">No hay votos aún</p>';
    }
    
    // Determinar el ganador (mayor porcentaje)
    const sortedResults = [...results.results].sort((a, b) => b.percentage - a.percentage);
    const winnerPercentage = sortedResults[0].percentage;
    
    return `
      <div class="space-y-4">
        <p class="text-sm text-gray-400 mb-4">Total de votos: <span class="text-white font-bold text-lg">${results.totalVotes}</span></p>
        ${sortedResults.map((result, index) => {
          const isWinning = result.percentage === winnerPercentage && result.percentage > 0;
          const position = index + 1;
          
          // Colores dinámicos según posición
          let barColor = 'from-gray-500 to-gray-600';
          let borderColor = 'border-gray-500/30';
          let badgeColor = 'bg-gray-500/20 text-gray-300';
          let emoji = '';
          
          if (isWinning) {
            barColor = 'from-yellow-400 via-yellow-500 to-orange-500';
            borderColor = 'border-yellow-400/50';
            badgeColor = 'bg-yellow-500/20 text-yellow-300 border border-yellow-400/30';
            emoji = '🏆 ';
          } else if (position === 2) {
            barColor = 'from-gray-300 to-gray-400';
            borderColor = 'border-gray-400/40';
            badgeColor = 'bg-gray-400/20 text-gray-300';
            emoji = '🥈 ';
          } else if (position === 3) {
            barColor = 'from-orange-600 to-orange-700';
            borderColor = 'border-orange-600/40';
            badgeColor = 'bg-orange-600/20 text-orange-300';
            emoji = '🥉 ';
          } else {
            barColor = 'from-blue-500 to-purple-500';
            borderColor = 'border-blue-500/30';
          }
          
          return `
            <div class="relative p-4 rounded-xl bg-white/5 border-2 ${borderColor} hover:bg-white/10 transition-all duration-300 ${isWinning ? 'ring-2 ring-yellow-400/30 shadow-lg shadow-yellow-500/20' : ''}">
              <div class="flex justify-between items-center mb-3">
                <div class="flex items-center gap-3">
                  ${isWinning ? '<span class="text-2xl animate-bounce">👑</span>' : ''}
                  <div>
                    <span class="text-white text-base font-bold ${isWinning ? 'text-yellow-300 text-lg' : ''}">${emoji}${result.candidateName}</span>
                    <div class="flex gap-2 mt-1">
                      <span class="px-2 py-0.5 rounded text-xs font-semibold ${badgeColor}">#${position}</span>
                      ${isWinning ? '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-green-500/20 text-green-300 border border-green-400/30 animate-pulse">Ganando</span>' : ''}
                    </div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-white font-bold text-xl ${isWinning ? 'text-yellow-300' : ''}">${result.percentage.toFixed(1)}%</div>
                  <div class="text-gray-400 text-xs">${result.votes} voto${result.votes !== 1 ? 's' : ''}</div>
                </div>
              </div>
              
              <!-- Barra de progreso -->
              <div class="relative">
                <div class="w-full bg-black/40 rounded-full h-4 overflow-hidden shadow-inner">
                  <div class="bg-gradient-to-r ${barColor} h-full rounded-full transition-all duration-1000 ease-out relative overflow-hidden" 
                       style="width: ${result.percentage}%">
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent animate-shimmer"></div>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  async function vote(candidateId) {
    try {
      // Importar VotingService
      const { votingService } = await import('../../services/VotingService');
      
      const voteFee = votingService.getVoteFee();
      
      // Confirmar con el usuario mostrando el costo
      const confirmMessage = `¿Confirmas tu voto?\n\n💰 Este voto consumirá ${voteFee} XLM de tu wallet.\n\nLa transacción será procesada en la blockchain de Stellar.`;
      
      if (!confirm(confirmMessage)) {
        return;
      }
      
      // Mostrar indicador de carga
      const voteContent = document.getElementById('voteContent');
      const originalContent = voteContent.innerHTML;
      
      voteContent.innerHTML = `
        <div class="text-center py-8">
          <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-blue-500 mx-auto mb-4"></div>
          <p class="text-white text-lg font-semibold mb-2">Procesando tu voto...</p>
          <p class="text-gray-400 text-sm">1. Verificando balance</p>
          <p class="text-gray-400 text-sm">2. Procesando pago de ${voteFee} XLM</p>
          <p class="text-gray-400 text-sm">3. Registrando voto</p>
        </div>
      `;
      
      // Ejecutar votación con pago XLM
      const result = await votingService.vote({
        surveyId: currentSurveyId,
        candidateId: candidateId,
        voterAddress: publicKey
      });
      
      if (result.success) {
        // Mostrar éxito con detalles de la transacción
        let successMessage = result.message;
        if (result.transactionHash) {
          successMessage += `\n\n🔗 Hash de transacción:\n${result.transactionHash.substring(0, 20)}...`;
          successMessage += `\n\n📊 Puedes verificar tu transacción en Stellar Expert (testnet)`;
        }
        alert(successMessage);
        
        // Recargar el modal para mostrar resultados actualizados
        openVoteModal(currentSurveyId);
      } else {
        // Restaurar contenido original y mostrar error
        voteContent.innerHTML = originalContent;
        alert('❌ ' + result.message);
      }
    } catch (error) {
      console.error('Error al votar:', error);
      
      // Restaurar contenido original si es posible
      const voteContent = document.getElementById('voteContent');
      if (voteContent && typeof originalContent !== 'undefined') {
        voteContent.innerHTML = originalContent;
      }
      
      alert('Error inesperado al procesar tu voto: ' + error.message);
    }
  }

  // Cerrar modal
  function closeVoteModal() {
    document.getElementById('voteModal').classList.add('hidden');
    currentSurveyId = null;
  }

  // Editar encuesta
  async function editSurvey(id) {
    try {
      const response = await fetch(`${API_URL}/api/surveys/${id}`);
      const survey = await response.json();
      
      // Llenar el formulario
      document.getElementById('surveyId').value = survey._id;
      document.getElementById('name').value = survey.name;
      document.getElementById('description').value = survey.description;
      
      // Actualizar contadores
      document.getElementById('candidateCount').textContent = (survey.candidates || []).length;
      document.getElementById('descriptionCount').textContent = survey.description.length;
      
      // Formatear fechas para datetime-local
      const startDate = new Date(survey.start_date);
      const endDate = new Date(survey.end_date);
      document.getElementById('start_date').value = formatDateTimeLocal(startDate);
      document.getElementById('end_date').value = formatDateTimeLocal(endDate);
      
      // Seleccionar candidatos en el nuevo sistema de checkboxes
      selectedCandidateIds = survey.candidates || [];
      document.getElementById('selectedCandidates').value = selectedCandidateIds.join(',');
      
      // Marcar visualmente los candidatos seleccionados
      const candidateCards = document.querySelectorAll('.candidate-card');
      candidateCards.forEach(card => {
        const checkbox = card.querySelector('.candidate-checkbox');
        const candidateId = checkbox.value;
        
        if (selectedCandidateIds.includes(candidateId)) {
          checkbox.checked = true;
          const checkboxCustom = card.querySelector('.checkbox-custom');
          const checkmark = card.querySelector('.checkmark');
          const cardDiv = card.querySelector('div');
          
          checkboxCustom.classList.add('bg-purple-600', 'border-purple-600');
          checkmark.classList.remove('hidden');
          cardDiv.classList.add('ring-2', 'ring-purple-500/50', 'bg-purple-500/10');
        }
      });
      
      publicKey = survey.created_by;
      
      // Cambiar el botón de submit
      isEditing = true;
      editingId = id;
      document.getElementById('submitBtnText').textContent = '✏️ Actualizar';
      document.getElementById('cancelBtn').style.display = 'inline-block';
      document.getElementById('formAlert').classList.add('hidden');
      
      // Validar el formulario
      validateForm();
      
      // Scroll al formulario
      document.getElementById('surveyForm').scrollIntoView({ behavior: 'smooth' });
    } catch (error) {
      console.error('Error al cargar encuesta:', error);
      document.getElementById('formAlert').classList.remove('hidden');
      document.getElementById('formAlert').innerHTML = `
        <div class="bg-red-500/20 border-red-500 text-red-300">
          <strong>❌ Error:</strong> No se pudieron cargar los datos de la encuesta
        </div>
      `;
    }
  }

  // Eliminar encuesta
  async function deleteSurvey(id) {
    if (!confirm('¿Estás seguro de que deseas eliminar esta encuesta?')) {
      return;
    }
    
    try {
      const response = await fetch(`${API_URL}/api/surveys/${id}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        alert('Encuesta eliminada exitosamente');
        loadSurveys();
      } else {
        throw new Error('Error al eliminar encuesta');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error al eliminar encuesta');
    }
  }

  // Cancelar edición
  function cancelEdit() {
    isEditing = false;
    editingId = null;
    document.getElementById('surveyForm').reset();
    document.getElementById('surveyId').value = '';
    document.getElementById('submitBtnText').textContent = '✨ Crear Encuesta';
    document.getElementById('cancelBtn').style.display = 'none';
    document.getElementById('formAlert').classList.add('hidden');
    
    // Limpiar selección de candidatos
    selectedCandidateIds = [];
    document.getElementById('selectedCandidates').value = '';
    document.getElementById('candidateCount').textContent = '0';
    document.getElementById('descriptionCount').textContent = '0';
    
    // Desmarcar todos los checkboxes visualmente
    const candidateCards = document.querySelectorAll('.candidate-card');
    candidateCards.forEach(card => {
      const checkbox = card.querySelector('.candidate-checkbox');
      const checkboxCustom = card.querySelector('.checkbox-custom');
      const checkmark = card.querySelector('.checkmark');
      const cardDiv = card.querySelector('div');
      
      checkbox.checked = false;
      checkboxCustom.classList.remove('bg-purple-600', 'border-purple-600');
      checkmark.classList.add('hidden');
      cardDiv.classList.remove('ring-2', 'ring-purple-500/50', 'bg-purple-500/10');
    });
    
    // Restaurar estado del formulario
    validateForm();
    
    // Restaurar la wallet conectada si existe
    if (freighterService.publicKey) {
      publicKey = freighterService.publicKey;
      updateWalletButton(true);
    } else {
      publicKey = null;
      updateWalletButton(false);
    }
  }

  // Formatear fecha para input datetime-local
  function formatDateTimeLocal(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    return `${year}-${month}-${day}T${hours}:${minutes}`;
  }
  // Crear o actualizar encuesta
  document.getElementById('surveyForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(e.target);
    const candidatesValue = document.getElementById('selectedCandidates').value;
    const candidatesArray = candidatesValue ? candidatesValue.split(',').filter(id => id) : [];
    
    const formAlert = document.getElementById('formAlert');
    const submitBtn = document.getElementById('submitBtn');
    
    // Validar candidatos (doble verificación)
    if (candidatesArray.length === 0) {
      document.getElementById('candidatesError').classList.remove('hidden');
      formAlert.classList.remove('hidden');
      formAlert.innerHTML = `
        <div class="bg-red-500/20 border-red-500 text-red-300">
          <strong>⚠️ Error de validación:</strong> Debes seleccionar al menos un candidato
        </div>
      `;
      return;
    }
    
    // Validar que la fecha de fin es posterior a la de inicio
    const startDate = new Date(formData.get('start_date'));
    const endDate = new Date(formData.get('end_date'));
    
    if (startDate >= endDate) {
      document.getElementById('endDateError').classList.remove('hidden');
      formAlert.classList.remove('hidden');
      formAlert.innerHTML = `
        <div class="bg-red-500/20 border-red-500 text-red-300">
          <strong>⚠️ Error de validación:</strong> La fecha de fin debe ser posterior a la fecha de inicio
        </div>
      `;
      return;
    }

    // Cobrar tarifa de creación si no se está editando
    let creationTxHash = null;
    if (!isEditing) {
      if (!publicKey) {
        formAlert.classList.remove('hidden');
        formAlert.innerHTML = `
          <div class="bg-red-500/20 border-red-500 text-red-300">
            <strong>⚠️ Error de pago:</strong> Debes conectar tu wallet para realizar el pago de creación de la encuesta (5.0 XLM).
          </div>
        `;
        return;
      }

      const confirmMsg = `💰 Crear una encuesta tiene un costo de 5.0 XLM.\n\n¿Deseas proceder con el pago desde tu wallet?`;
      if (!confirm(confirmMsg)) {
        return;
      }

      const txModal = document.getElementById('txModal');
      const txTitle = document.getElementById('txTitle');
      const txMessage = document.getElementById('txMessage');
      const txSpinner = document.getElementById('txSpinner');
      const txSuccess = document.getElementById('txSuccess');
      const txError = document.getElementById('txError');
      const txCloseBtn = document.getElementById('txCloseBtn');
      const txDetails = document.getElementById('txDetails');

      try {
        submitBtn.disabled = true;
        document.getElementById('submitBtnText').textContent = '⏳ Procesando pago XLM...';
        formAlert.classList.add('hidden');
        
        // Mostrar modal
        txModal.classList.remove('hidden');
        txSpinner.classList.remove('hidden');
        txSuccess.classList.add('hidden');
        txError.classList.add('hidden');
        txCloseBtn.classList.add('hidden');
        txDetails.classList.add('hidden');
        
        txTitle.textContent = 'Autorizando Transacción';
        txTitle.className = 'text-2xl font-bold text-white mb-3';
        txMessage.textContent = 'Por favor aprueba el cobro de 5.0 XLM en la ventana de Freighter...';

        const { votingService } = await import('../../services/VotingService');
        const paymentResult = await votingService.paySurveyCreationFee();

        if (!paymentResult.success) {
          throw new Error(paymentResult.message || 'Error al procesar el pago de creación.');
        }

        creationTxHash = paymentResult.transactionHash;
        console.log('✅ Pago de creación exitoso. Hash:', creationTxHash);
        
        txSpinner.classList.add('hidden');
        txSuccess.classList.remove('hidden');
        txTitle.textContent = 'Pago Exitoso';
        txTitle.className = 'text-2xl font-bold text-green-400 mb-3';
        txMessage.textContent = 'Guardando encuesta en la base de datos...';
        txDetails.classList.remove('hidden');
        txDetails.innerHTML = `<strong>Hash de Transacción:</strong><br>${creationTxHash}`;
        
        // Esperar 1.5s antes de cerrar el modal automáticamente
        await new Promise(resolve => setTimeout(resolve, 1500));
        txModal.classList.add('hidden');
        
      } catch (err: any) {
        console.error('Error al procesar pago de creación:', err);
        txSpinner.classList.add('hidden');
        txError.classList.remove('hidden');
        txTitle.textContent = 'Transacción Fallida';
        txTitle.className = 'text-2xl font-bold text-red-400 mb-3';
        txMessage.textContent = err.message;
        txCloseBtn.classList.remove('hidden');
        
        submitBtn.disabled = false;
        document.getElementById('submitBtnText').textContent = '✨ Crear Encuesta';
        return;
      }
    }
    
    const surveyData = {
      name: formData.get('name'),
      description: formData.get('description'),
      start_date: formData.get('start_date'),
      end_date: formData.get('end_date'),
      candidates: candidatesArray,
      created_by: publicKey || 'admin',
      creation_tx_hash: creationTxHash
    };

    try {
      // Desabilitar botón mientras se procesa
      submitBtn.disabled = true;
      document.getElementById('submitBtnText').textContent = '⏳ Procesando...';

      const url = isEditing 
        ? `${API_URL}/api/surveys/${editingId}`
        : `${API_URL}/api/surveys`;
        
      const method = isEditing ? 'PUT' : 'POST';
      
      const response = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(surveyData)
      });

      const data = await response.json();

      if (response.ok) {
        formAlert.classList.remove('hidden');
        formAlert.innerHTML = `
          <div class="bg-green-500/20 border-green-500 text-green-300">
            <strong>✅ Éxito:</strong> Encuesta ${isEditing ? 'actualizada' : 'creada'} exitosamente ${creationTxHash ? `(Hash Pago: ${creationTxHash.substring(0, 10)}...)` : ''}
          </div>
        `;
        
        // Limpiar el formulario después de 2 segundos
        setTimeout(() => {
          cancelEdit();
          loadSurveys();
          formAlert.classList.add('hidden');
        }, 2000);
      } else {
        throw new Error(data.error || 'Error desconocido al guardar encuesta');
      }
    } catch (error) {
      console.error('Error completo:', error);
      formAlert.classList.remove('hidden');
      formAlert.innerHTML = `
        <div class="bg-red-500/20 border-red-500 text-red-300">
          <strong>❌ Error:</strong> ${error.message}
        </div>
      `;
    } finally {
      submitBtn.disabled = false;
      document.getElementById('submitBtnText').textContent = isEditing ? '✏️ Actualizar' : '✨ Crear Encuesta';
    }
  });

  // Event Listeners
  async function initSurveys() {
    document.getElementById('cancelBtn')?.addEventListener('click', cancelEdit);
    
    // Auto-detectar wallet al cargar
    await autoDetectWallet();
    
    loadCandidateOptions();
    loadSurveys();
    
    // Validar el formulario inicial
    validateForm();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSurveys);
  } else {
    initSurveys();
  }

  // Hacer funciones globales
  window.editSurvey = editSurvey;
  window.deleteSurvey = deleteSurvey;
  window.openVoteModal = openVoteModal;
  window.closeVoteModal = closeVoteModal;
  window.vote = vote;

  // Global functions for modal
  function closeTxModal() {
    document.getElementById('txModal').classList.add('hidden');
  }
  window.closeTxModal = closeTxModal;

</script>

