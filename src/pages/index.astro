---
import Layout from '../layouts/Layout.astro';
import SurveyCardGrid from '../components/SurveyCardGrid.astro';
import AuthGuard from '../components/AuthGuard.astro';

// Definir las variables que se usarán en el cliente
const CONTRACT_ID = "GC627W5PYYE5SXWAKC4LB72OYY3JMCP33N7KZ6EILCWAQNHIQDMB3O5W";
---

<AuthGuard allowedRoles={['admin']} />

<Layout title="CenVote - Sistema de Votación Descentralizada">
  <div class="min-h-screen bg-gradient-to-br from-slate-950 via-purple-900 to-slate-950">
    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-16 animate-fadeInUp">
        <h2 class="text-5xl sm:text-6xl font-black mb-6 header-gradient">
          Bienvenido a CenVote
        </h2>
        <p class="mt-6 max-w-3xl mx-auto text-xl text-gray-300 font-light">
          La plataforma de votación descentralizada más segura y transparente
        </p>
        <div class="mt-8 flex justify-center gap-4">
          <a href="/surveys" class="btn-primary">
            ✨ Comenzar
          </a>
          <a href="/candidates" class="btn-secondary">
            📖 Conocer Más
          </a>
        </div>
      </div>

      <!-- Features Grid -->
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <!-- Candidates Card -->
        <a href="/candidates" class="card-gradient group hover:scale-105 transition-transform duration-300 p-8 rounded-2xl border border-white/20 backdrop-blur-xl hover:border-purple-500/50">
          <div class="text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">🎯</div>
          <h3 class="text-2xl font-bold text-white mb-3">Gestión de Candidatos</h3>
          <p class="text-gray-400 text-lg">Administra candidatos para las votaciones de forma descentralizada</p>
          <div class="mt-6 text-purple-400 group-hover:translate-x-2 transition-transform">→ Ver más</div>
        </a>

        <!-- Surveys Card -->
        <a href="/surveys" class="card-gradient group hover:scale-105 transition-transform duration-300 p-8 rounded-2xl border border-white/20 backdrop-blur-xl hover:border-pink-500/50">
          <div class="text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">📊</div>
          <h3 class="text-2xl font-bold text-white mb-3">Gestión de Encuestas</h3>
          <p class="text-gray-400 text-lg">Crea y administra encuestas de votación en tiempo real</p>
          <div class="mt-6 text-pink-400 group-hover:translate-x-2 transition-transform">→ Ver más</div>
        </a>
      </div>

      <!-- Stats Section -->
      <div class="grid md:grid-cols-4 gap-6 mb-16">
        <div class="card-glass p-6 text-center rounded-2xl">
          <div class="text-4xl font-bold bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent mb-2">100%</div>
          <p class="text-gray-400">Seguro</p>
        </div>
        <div class="card-glass p-6 text-center rounded-2xl">
          <div class="text-4xl font-bold bg-gradient-to-r from-purple-400 to-purple-600 bg-clip-text text-transparent mb-2">24/7</div>
          <p class="text-gray-400">Disponible</p>
        </div>
        <div class="card-glass p-6 text-center rounded-2xl">
          <div class="text-4xl font-bold bg-gradient-to-r from-pink-400 to-pink-600 bg-clip-text text-transparent mb-2">∞</div>
          <p class="text-gray-400">Escalable</p>
        </div>
        <div class="card-glass p-6 text-center rounded-2xl">
          <div class="text-4xl font-bold bg-gradient-to-r from-emerald-400 to-emerald-600 bg-clip-text text-transparent mb-2">⚡</div>
          <p class="text-gray-400">Rápido</p>
        </div>
      </div>
      </div>

      <!-- Active Surveys Section (Full Width) -->
      <div class="mt-24 mb-12 animate-fadeInUp delay-300">
        <SurveyCardGrid />
      </div>
    </div>
  </div>

<script>
import { freighterService } from '../services/FreighterService';

// El CONTRACT_ID se pasa desde el servidor
declare const CONTRACT_ID: string;

async function invokeContractFunction(method: string, args: any[] = []) {
  try {
    console.log('📞 Invocando función de contrato:', method);

    // Verificar instalación de Freighter
    const isInstalled = await freighterService.isFreighterInstalled();
    if (!isInstalled) {
      const shouldInstall = confirm('Freighter no está instalado. ¿Deseas ir a la página de instalación?');
      if (shouldInstall) {
        window.open('https://www.freighter.app', '_blank');
      }
      return;
    }

    // Verificar conexión
    if (!freighterService.isConnected) {
      const shouldConnect = confirm("Debes conectar tu wallet primero. ¿Conectar ahora?");
      if (shouldConnect) {
        const result = await freighterService.connect();
        if (!result.success) {
          alert(`❌ ${result.message}`);
          return;
        }
      } else {
        return;
      }
    }

    // Verificar disponibilidad de la API
    const freighterApi = (window as any).freighterApi;
    if (!freighterApi) {
      alert('No se puede acceder a la API de Freighter. Por favor recarga la página.');
      return;
    }

    // Obtener información necesaria
    const publicKey = freighterService.publicKey;
    const networkDetails = freighterService.networkDetails;
    
    if (!publicKey || !networkDetails) {
      throw new Error("No se pudo obtener la información de la wallet");
    }

    console.log('📋 Preparando transacción con:', {
      network: networkDetails.network,
      publicKey: `${publicKey.slice(0, 6)}...${publicKey.slice(-6)}`,
      contractId: CONTRACT_ID,
      method,
      args
    });

    // TODO: Implementar llamada al contrato Soroban
    // Por ahora, esto es un placeholder
    console.log('⚠️ La integración con el contrato Soroban está pendiente');
    alert('La funcionalidad de contratos está en desarrollo. Tu wallet está conectada correctamente.');

    /* 
    // Ejemplo de cómo se vería la integración completa:
    const transactionXDR = await freighterApi.getTransaction({
      network: networkDetails.network,
      source: publicKey,
      contractId: CONTRACT_ID,
      method,
      args
    });

    // Firmar la transacción
    const { signed, error } = await freighterService.signTransaction(transactionXDR);
    if (error) {
      throw new Error(error);
    }

    // Enviar la transacción
    console.log('📤 Enviando transacción firmada...');
    const txResponse = await freighterApi.signAndSubmitTransaction(signed);
    console.log("✅ Transacción completada:", txResponse);
    return txResponse;
    */
  } catch (err) {
    console.error("❌ Error en invokeContractFunction:", err);
    alert(`Error en la transacción: ${err instanceof Error ? err.message : 'Error desconocido'}`);
  }
}

// Exponer función globalmente para testing
(window as any).invokeContractFunction = invokeContractFunction;

// Inicializar la conexión al cargar la página
async function initIndex() {
  console.log('🚀 Inicializando CenVote DApp...');
  
  // Verificar si hay una sesión de wallet guardada
  const isConnected = await freighterService.checkConnection();
  if (isConnected && freighterService.publicKey) {
    console.log('✅ Wallet ya conectada:', `${freighterService.publicKey.slice(0, 6)}...${freighterService.publicKey.slice(-6)}`);
    
    // Intentar reconectar automáticamente
    const result = await freighterService.connect();
    if (result.success) {
      console.log('✅ Reconexión automática exitosa');
    } else {
      console.log('⚠️ No se pudo reconectar automáticamente:', result.message);
    }
  } else {
    console.log('ℹ️ No hay wallet conectada. Por favor conecta tu Freighter wallet.');
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initIndex);
} else {
  initIndex();
}
</script>
</Layout>