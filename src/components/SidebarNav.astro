---
// SidebarNav.astro - Navegación lateral fija
import WalletConnector from './WalletConnector.astro';
const currentPath = Astro.url.pathname;

interface NavItem {
  label: string;
  path: string;
  icon: string;
  description: string;
}

const navItems: NavItem[] = [
  {
    label: "Inicio",
    path: "/",
    icon: "🏠",
    description: "Panel principal"
  },
  {
    label: "Candidatos",
    path: "/candidates",
    icon: "🎯",
    description: "Gestionar candidatos"
  },
  {
    label: "Encuestas",
    path: "/surveys",
    icon: "📊",
    description: "Gestionar encuestas"
  }
];

const isActive = (path: string) => {
  if (path === "/" && currentPath === "/") return true;
  if (path !== "/" && currentPath.startsWith(path)) return true;
  return false;
};
---

<!-- Overlay de fondo para móvil -->
<div id="sidebar-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-30 hidden"></div>

<!-- Botón de Menú Móvil -->
<button id="mobile-menu-toggle" class="fixed top-4 left-4 z-50 p-3 rounded-xl bg-slate-900/90 border border-white/15 backdrop-blur-md text-white hover:bg-slate-800 transition-all duration-300 shadow-lg shadow-black/30" aria-label="Abrir menú">
  <span id="menu-icon" class="text-xl block w-6 h-6 flex items-center justify-center">☰</span>
</button>

<nav class="fixed left-0 top-0 h-screen w-64 flex flex-col bg-gradient-to-b from-slate-900 via-purple-900/50 to-slate-900 border-r border-white/10 backdrop-blur-xl z-40 shadow-2xl">
  <!-- Logo Section -->
  <div class="p-6 border-b border-white/10 flex-shrink-0">
    <div class="flex items-center gap-3 mb-2">
      <div class="text-3xl">🗳️</div>
      <h1 class="text-xl font-black bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
        CenVote
      </h1>
    </div>
    <p class="text-xs text-gray-400">Plataforma de Votación Descentralizada</p>
  </div>

  <!-- Navigation Items -->
  <div class="flex-1 p-4 space-y-2 overflow-y-auto">
    {navItems.map((item) => (
      <a
        href={item.path}
        class={`group flex items-start gap-3 px-4 py-3 rounded-lg transition-all duration-300 ${
          isActive(item.path)
            ? "bg-gradient-to-r from-purple-600/40 to-blue-600/40 border border-purple-400/30 shadow-lg shadow-purple-500/20"
            : "hover:bg-white/5 border border-transparent"
        }`}
        title={item.description}
      >
        <span class="text-2xl group-hover:scale-110 transition-transform duration-300">
          {item.icon}
        </span>
        <div class="flex-1">
          <div class={`text-sm font-semibold ${
            isActive(item.path)
              ? "text-white"
              : "text-gray-300 group-hover:text-white"
          }`}>
            {item.label}
          </div>
          <div class="text-xs text-gray-500 group-hover:text-gray-400">
            {item.description}
          </div>
        </div>
        {isActive(item.path) && (
          <div class="w-1 h-6 bg-gradient-to-b from-purple-400 to-blue-400 rounded-full"></div>
        )}
      </a>
    ))}
  </div>

  <!-- User Section (Dynamic) -->
  <div id="sidebar-user-section" class="p-4 border-t border-white/10 bg-slate-950/30 flex-shrink-0 hidden">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-white font-bold text-lg" id="user-avatar">
        U
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-bold text-white truncate" id="user-name">Usuario</p>
        <p class="text-xs text-purple-300 capitalize" id="user-role">Votante</p>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <a href="/profile" class="text-center text-xs py-2 px-2 rounded-lg bg-white/5 border border-white/10 text-gray-300 hover:bg-white/10 hover:text-white transition-all font-semibold">
        👤 Perfil
      </a>
      <button id="logout-btn" class="text-center text-xs py-2 px-2 rounded-lg bg-red-950/40 border border-red-500/20 text-red-400 hover:bg-red-900/40 hover:text-red-300 transition-all font-semibold">
        🚪 Salir
      </button>
    </div>
  </div>

  <!-- Stats Section -->
  <div class="p-4 border-t border-white/10 bg-slate-950/50 flex-shrink-0">
    <!-- Wallet Connection Section -->
    <div class="mb-4">
      <p class="text-[10px] font-bold text-purple-300 uppercase tracking-wider mb-2 px-1">Cartera Stellar</p>
      <WalletConnector />
    </div>
    
    <div class="h-px bg-white/10 my-3"></div>

    <div class="space-y-2 text-xs">
      <div class="flex justify-between items-center">
        <span class="text-gray-400">Estado:</span>
        <span class="text-green-400 flex items-center gap-1">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          Activo
        </span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-gray-400">Red:</span>
        <span class="text-blue-400">Testnet</span>
      </div>
      <div class="h-px bg-white/10 my-3"></div>
      <p class="text-gray-500 text-center py-1">
        © 2026 CenVote
      </p>
    </div>
  </div>
</nav>

<script>
  import { authService } from '../services/AuthService';

  // Toggle Menú Móvil
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const sidebar = document.querySelector('nav');
  const icon = document.getElementById('menu-icon');
  const overlay = document.getElementById('sidebar-overlay');

  function closeSidebar() {
    if (sidebar && icon && toggleBtn && overlay) {
      sidebar.classList.remove('active');
      icon.textContent = '☰';
      toggleBtn.style.left = '1rem';
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  function openSidebar() {
    if (sidebar && icon && toggleBtn && overlay) {
      sidebar.classList.add('active');
      icon.textContent = '✕';
      toggleBtn.style.left = '17rem';
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  if (toggleBtn && sidebar && icon) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = sidebar.classList.contains('active');
      if (isOpen) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });
    
    // Cerrar con overlay
    overlay?.addEventListener('click', closeSidebar);

    // Cerrar al hacer clic fuera
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (sidebar.classList.contains('active') && 
          !sidebar.contains(target) && 
          !toggleBtn.contains(target)) {
        closeSidebar();
      }
    });
  }

  // Cargar sesión del usuario dinámicamente
  function setupUserSession() {
    const userSection = document.getElementById('sidebar-user-section');
    const userName = document.getElementById('user-name');
    const userRole = document.getElementById('user-role');
    const userAvatar = document.getElementById('user-avatar');
    const logoutBtn = document.getElementById('logout-btn');

    if (authService.isAuthenticated()) {
      const user = authService.getUser();
      if (user && userSection && userName && userRole && userAvatar) {
        userSection.classList.remove('hidden');
        
        const displayName = user.first_name || user.email || 'Usuario';
        userName.textContent = displayName;
        userRole.textContent = user.role === 'admin' ? '🛡️ Administrador' : '🗳️ Votante';
        userAvatar.textContent = displayName.charAt(0).toUpperCase();

        // Adaptar menú para usuarios normales
        if (user.role === 'user') {
          const navLinks = document.querySelectorAll('nav a');
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            // Ocultar páginas de gestión administrativa
            if (href === '/users' || href === '/candidates' || href === '/surveys') {
              (link as HTMLElement).style.display = 'none';
            }
            // Redirigir Home a Dashboard
            if (href === '/') {
              link.setAttribute('href', '/dashboard');
              const labelEl = link.querySelector('div div');
              if (labelEl && labelEl.textContent === 'Inicio') {
                const descEl = link.querySelector('div div:nth-child(2)');
                if (descEl) descEl.textContent = 'Mi panel de votación';
              }
            }
          });
        }
      }
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        authService.logout();
      });
    }
  }

  // Inicializar al cargar
  setupUserSession();
</script>

<style is:global>
  #mobile-menu-toggle {
    display: none;
  }

  /* Ajustar el main content para dejar espacio al sidebar */
  body {
    --sidebar-width: 16rem; /* 64 * 0.25rem */
  }

  main, .main-content {
    margin-left: var(--sidebar-width);
  }

  @media (max-width: 768px) {
    #mobile-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    main, .main-content {
      margin-left: 0 !important;
      padding-top: 3.5rem; /* Espacio para el botón hamburguesa */
    }

    nav {
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    nav.active {
      transform: translateX(0);
      box-shadow: 4px 0 30px rgba(0, 0, 0, 0.5);
    }

    /* Ocultar secciones pesadas en sidebar móvil para ahorrar espacio */
    nav .text-\[10px\] {
      font-size: 9px;
    }
  }
</style>
